TS_AUTHKEY=tskey-auth-example
TS_HOSTNAME=tailscale-mcp
# Optional full Serve host override, for example tailscale-mcp.example.ts.net:443.
# Defaults to ${TS_HOSTNAME}:443 when unset.
TS_SERVE_HOST=

# src/security/auth.ts rejects non-.ts.net Host values unless they are
# allow-listed here. Add custom short TS_HOSTNAME values to MCP_ALLOWED_HOSTS.
MCP_ALLOWED_HOSTS=tailscale-mcp,localhost,127.0.0.1
MCP_HTTP_BEARER_TOKEN=replace-with-at-least-32-random-characters
MCP_HTTP_PORT=3000

TAILSCALE_TAILNET=-
TAILSCALE_OAUTH_CLIENT_ID=
TAILSCALE_OAUTH_CLIENT_SECRET=
TAILSCALE_API_KEY=
TAILSCALE_ALLOWED_TOOL_RISK=read
LOG_LEVEL=info
