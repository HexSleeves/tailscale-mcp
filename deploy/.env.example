# DO NOT COMMIT REAL VALUES — copy this file to .env and fill in your secrets
# cp .env.example .env

# ---------------------------------------------------------------------------
# Tailscale sidecar (ts-mcp)
# ---------------------------------------------------------------------------

# Required. OAuth client secret from https://login.tailscale.com/admin/settings/oauth
# The client must have the "auth_keys" write scope and advertise tag:mcp-server.
# Generate as ephemeral so the node is removed from the tailnet on shutdown.
# TS_AUTHKEY=tskey-client-xxxxxxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional. Hostname this node advertises on the tailnet. Default: tailscale-mcp
# TS_HOSTNAME=tailscale-mcp

# ---------------------------------------------------------------------------
# App service (app)
# ---------------------------------------------------------------------------

# Required. Your tailnet name (e.g. example.com or example.ts.net).
# TAILSCALE_TAILNET=example.ts.net

# Required. OAuth client ID for Tailscale API access.
# TAILSCALE_OAUTH_CLIENT_ID=tskey-client-xxxxxxxxxxxxxxxx

# Required. OAuth client secret for Tailscale API access.
# TAILSCALE_OAUTH_CLIENT_SECRET=tskey-client-xxxxxxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional. Tailscale API base URL. Default: https://api.tailscale.com
# TAILSCALE_API_BASE_URL=https://api.tailscale.com

# Optional. Port the app listens on inside the container. Default: 3000
# HTTP_PORT=3000

# Optional. Comma-separated list of allowed Host header values.
# Default: tailscale-mcp,localhost,127.0.0.1
# HTTP_ALLOWED_HOSTS=tailscale-mcp,localhost,127.0.0.1

# Optional. Log verbosity: trace | debug | info | warn | error. Default: info
# LOG_LEVEL=info
