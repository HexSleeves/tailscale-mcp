{
  "name": "@hexsleeves/tailscale-mcp-server",
  "version": "1.0.0-rc.1",
  "description": "MCP server for Tailscale CLI + REST API.",
  "keywords": [
    "tailscale",
    "mcp",
    "model context protocol",
    "tailscale mcp",
    "tailscale mcp server"
  ],
  "author": "HexSleeves",
  "license": "MIT",
  "type": "module",
  "bin": {
    "tailscale-mcp-server": "./dist/server"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "files": [
    "dist/**/*",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "bun --hot src/main.ts",
    "start": "bun src/main.ts",
    "build": "bun build src/main.ts --compile --target=bun --outfile=dist/server",
    "build:node": "bun build src/main.ts --target=node --format=esm --outfile=dist/server.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "bun test",
    "test:cov": "bun test --coverage",
    "inspector": "bunx @modelcontextprotocol/inspector bun src/main.ts",
    "audit": "bun audit",
    "qa": "bun run typecheck && bun run lint && bun run test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "hono": "4.12.15",
    "ipaddr.js": "2.3.0",
    "pino": "10.3.1",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.13",
    "@types/bun": "latest",
    "typescript": "6.0.3"
  }
}
